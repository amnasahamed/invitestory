# PostHog public project token and ingestion host
POSTHOG_API_KEY=phc_your_project_token
POSTHOG_HOST=https://us.i.posthog.com

# PostHog source-map upload credentials (personal key, project ID, and app host)
POSTHOG_CLI_API_KEY=phx_your_personal_api_key
POSTHOG_CLI_PROJECT_ID=your_project_id
POSTHOG_CLI_HOST=https://your-posthog-app-host.example

# Optional preview capture and secure checkout (off until configured)
WEBSITE_INTEGRATION_ENABLED=0
WEBSITE_PORTAL_ORIGIN=https://staff.invitestory.in
WEBSITE_BRIDGE_SECRET=
WEBSITE_TURNSTILE_SITE_KEY=
WEBSITE_TURNSTILE_SECRET=
# Local development only; permits a localhost portal URL
WEBSITE_ALLOW_LOCAL=0
