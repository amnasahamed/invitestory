{
  "name": "invitestory",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node serve.mjs",
    "start": "node --env-file=.env dist/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:bundle": "esbuild serve.mjs --bundle --platform=node --format=esm --packages=external --sourcemap=external --sources-content=true --outfile=dist/serve.mjs",
    "build": "node build.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@posthog/cli": "^0.18.9",
    "esbuild": "^0.28.2",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "posthog-node": "^5.55.0"
  }
}
