{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/digital-wedding-invitations",
      "destination": "/index.html"
    },
    {
      "source": "/muslim-wedding-invitations",
      "destination": "/index.html"
    },
    {
      "source": "/nikah-invitations",
      "destination": "/index.html"
    },
    {
      "source": "/walima-invitations",
      "destination": "/index.html"
    },
    {
      "source": "/kerala-wedding-websites",
      "destination": "/index.html"
    },
    {
      "source": "/tamil-wedding-invitations",
      "destination": "/index.html"
    },
    {
      "source": "/hindu-wedding-websites",
      "destination": "/index.html"
    },
    {
      "source": "/save-the-date",
      "destination": "/index.html"
    },
    {
      "source": "/wedding-website-india",
      "destination": "/index.html"
    },
    {
      "source": "/wedding-invitation-website",
      "destination": "/index.html"
    },
    {
      "source": "/templates/:slug((?!template-).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/llms-full.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
