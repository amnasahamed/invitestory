{
  "buildCommand": "echo 'No build required'",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/refunds", "destination": "/refund-and-editing-policy.html", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/digital-wedding-invitations",
      "destination": "/digital-wedding-invitations.html"
    },
    {
      "source": "/dearly",
      "destination": "/dearly.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "design",
          "value": "(?<design>.*)"
        }
      ],
      "destination": "/api/og?design=:design"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "preview",
          "value": "(?<preview>.*)"
        }
      ],
      "destination": "/api/og?preview=:preview"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.*)"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/designs",
      "has": [
        {
          "type": "query",
          "key": "design",
          "value": "(?<design>.*)"
        }
      ],
      "destination": "/api/og?design=:design"
    },
    {
      "source": "/designs",
      "destination": "/#catalogue-header"
    }
  ]
}
