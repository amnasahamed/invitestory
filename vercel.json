{
  "buildCommand": "echo 'No build required'",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/refunds", "destination": "/refund-and-editing-policy.html", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "design"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "preview"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "id"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/designs",
      "has": [
        {
          "type": "query",
          "key": "design"
        }
      ],
      "destination": "/api/og"
    },
    {
      "source": "/designs",
      "destination": "/#catalogue-header"
    }
  ]
}
