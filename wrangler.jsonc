{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invitestorywebsite",
  "main": "_worker.js",
  "compatibility_date": "2026-09-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/website/*",
      "/",
      "/index.html",
      "/digital-wedding-invitations",
      "/dearly",
      "/dearly/"
    ]
  }
}
